+/* The caller holds the home lock. Only shard 0 may nest shard 1.
+ * All publications for a hot key hold its home lock; swapoff may remove
+ * an existing peer entry using the storage lock alone. A nonzero bucket
+ * count is a hint and the peer hash always verifies the complete key. */
+static u32 *ca_existing(struct ca_shard *home, unsigned long key,
+                        struct ca_shard **storage, unsigned long *peer_flags)
+{
+ struct ca_shard *peer = &ca_shards[1];
+ u32 *link = ca_find(home, key);
+ *storage = home;
+ if (!*link && cram_spill && home == &ca_shards[0] &&
+     READ_ONCE(peer->spill_buckets[hash_long(key, ca_hash_bits)])) {
+  *peer_flags = ca_enter(peer);
+  *storage = peer;
+  return ca_find(peer, key);
+ }
+ return link;
+}
+
+static void ca_drop_peer(struct ca_shard *home, struct ca_shard *storage, unsigned long flags)
+{
+ if (storage != home)
+  ca_leave(storage, flags);
+}
