+/* Group equal byte positions of consecutive four-byte words before LZ4. */
+static void ca_shuffle_page(u8 *dst, const u8 *src)
+{
+ unsigned int i, lane;
+ for (lane = 0; lane < 4; lane++)
+  for (i = 0; i < PAGE_SIZE / 4; i++)
+   dst[lane * (PAGE_SIZE / 4) + i] = src[4 * i + lane];
+}
+static void ca_unshuffle_page(u8 *dst, const u8 *src)
+{
+ unsigned int i, lane;
+ for (i = 0; i < PAGE_SIZE / 4; i++)
+  for (lane = 0; lane < 4; lane++)
+   dst[4 * i + lane] = src[lane * (PAGE_SIZE / 4) + i];
+}
