--- a/drivers/misc/vmw_balloon.c
+++ b/drivers/misc/vmw_balloon.c
@@ -39,6 +39,27 @@
 MODULE_ALIAS("dmi:*:svnVMware*:*");
 MODULE_ALIAS("vmware_vmmemctl");
 MODULE_LICENSE("GPL");
+
+/* Temporary lab offer. Expiry restores the normal host-directed decision. */
+static unsigned long cram_offer_until;
+static atomic_long_t cram_notneeded = ATOMIC_LONG_INIT(0);
+static atomic_long_t cram_refusals = ATOMIC_LONG_INIT(0);
+
+static int cram_offer_set(const char *value, const struct kernel_param *kp)
+{
+	unsigned int enable;
+	int ret = kstrtouint(value, 0, &enable);
+
+	if (ret || enable > 1)
+		return -EINVAL;
+	WRITE_ONCE(cram_offer_until, enable ? jiffies + 60 * HZ : 0);
+	return 0;
+}
+
+static const struct kernel_param_ops cram_offer_ops = {
+	.set = cram_offer_set,
+};
+module_param_cb(cram_offer_32m, &cram_offer_ops, NULL, 0200);
 
 static bool __read_mostly vmwballoon_shrinker_enable;
 module_param(vmwballoon_shrinker_enable, bool, 0444);
@@ -713,6 +734,9 @@
 	if (likely(status == VMW_BALLOON_SUCCESS))
 		return 0;
 
+	atomic_long_inc(&cram_refusals);
+	if (status == VMW_BALLOON_ERROR_PPN_NOTNEEDED)
+		atomic_long_inc(&cram_notneeded);
 	pr_debug("%s: failed comm pfn %lx status %lu page_size %s\n", __func__,
 		 page_to_pfn(page), status,
 		 vmballoon_page_size_names[page_size]);
@@ -955,6 +979,12 @@
 
 	size = atomic64_read(&b->size);
 	target = READ_ONCE(b->target);
+	if (!target) {
+		unsigned long until = READ_ONCE(cram_offer_until);
+
+		if (until && time_before(jiffies, until))
+			target = SZ_32M / PAGE_SIZE;
+	}
 
 	/*
 	 * We must cast first because of int sizes
@@ -1653,6 +1683,8 @@
 			return r;
 	}
 
+	seq_printf(f, "lab_refusals: %ld\n", atomic_long_read(&cram_refusals));
+	seq_printf(f, "lab_notneeded: %ld\n", atomic_long_read(&cram_notneeded));
 	/* format capabilities info */
 	seq_printf(f, "%-22s: %#16x\n", "balloon capabilities",
 		   VMW_BALLOON_CAPABILITIES);
