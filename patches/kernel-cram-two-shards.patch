+/* Counters and peaks sum over shards. The sum of peaks bounds simultaneous usage. */
+static int ca_stat_read(void *data, u64 *value)
+{
+ unsigned long offset = (unsigned long)data, flags;
+ unsigned int i;
+ *value = 0;
+ for (i = 0; i < ca_shard_count; i++) {
+  struct ca_shard *sh = &ca_shards[i];
+  spin_lock_irqsave(&sh->lock, flags);
+  *value += *(u64 *)((char *)sh + offset);
+  spin_unlock_irqrestore(&sh->lock, flags);
+ }
+ return 0;
+}
