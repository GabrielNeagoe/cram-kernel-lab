+ if (cram_two_shards && (!cram_wide_hash || !cram_index || !cram_demand || cram_zstd1))
+  return -EINVAL;
+ ca_shard_count = cram_two_shards ? 2 : 1;
+ for (i = 0; i < ca_shard_count; i++) {
+  ret = ca_setup_shard(&ca_shards[i], budget / ca_shard_count);
+  if (ret) {
+   while (i) {
+    struct ca_shard *sh = &ca_shards[--i];
+    vfree(sh->control);
+    sh->control = NULL;
+   }
+   return ret;
+  }
+ }
+ ca_bytes = budget;
+ return 0;
+}
