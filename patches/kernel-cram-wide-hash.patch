+/* The optional probe uses a failed trylock to count actual contended acquisitions. */
+static inline unsigned long ca_enter(void)
+{
+ unsigned long flags;
+ u64 start = ca_tick();
+ if (!start) {
+  spin_lock_irqsave(&ca_lock, flags);
+  return flags;
+ }
+ if (!spin_trylock_irqsave(&ca_lock, flags)) {
+  spin_lock_irqsave(&ca_lock, flags);
+  ca_acquired_at = ktime_get_ns();
+  ca_wait_ns += ca_acquired_at - start;
+  ca_contended++;
+ } else {
+  ca_acquired_at = ktime_get_ns();
+ }
+ ca_acquires++;
+ return flags;
+}
+
+static inline void ca_leave(unsigned long flags)
+{
+ if (ca_acquired_at) {
+  ca_hold_ns += ktime_get_ns() - ca_acquired_at;
+  ca_acquired_at = 0;
+ }
+ spin_unlock_irqrestore(&ca_lock, flags);
+}
+
 static u32 *ca_find(unsigned long key)
 {
  u64 start = ca_tick();
- u32 *p = &ca->heads[hash_long(key, 10)];
- while (*p && ca_at(*p)->key != key)
-  p = &ca_at(*p)->next;
+ u32 *p = &ca_heads[hash_long(key, ca_hash_bits)];
+ unsigned int visits = 0;
+ while (*p) {
+  struct ca_entry *entry = ca_at(*p);
+  visits++;
+  if (entry->key == key)
+   break;
+  p = &entry->next;
+ }
+ if (start) {
+  ca_lookups++;
+  ca_visits += visits;
+ }
  ca_elapsed(start, &ca_hash_ns);
  return p;
 }
