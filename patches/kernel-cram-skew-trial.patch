+/* Sample shard-zero full rejections. Acquire the peer only by trylock,
+ * always 0 -> 1, so this diagnostic never waits while holding the owner.
+ * With both locks held the two fit indexes describe the same instant. */
+static void ca_check_peer(struct ca_shard *sh, unsigned int blocks)
+{
+ struct ca_shard *peer = &ca_shards[1];
+ unsigned int chunks, chunk;
+ if (!cram_two_shards || sh != &ca_shards[0] || ((sh->full - 1) & 255))
+  return;
+ if (!spin_trylock(&peer->lock)) {
+  sh->peer_busy++;
+  return;
+ }
+ sh->peer_checks++;
+ chunks = peer->blocks / CA_SLOTS;
+ chunk = find_first_bit(peer->fit + (blocks - 1) * peer->row_words, chunks);
+ if (chunk < chunks) {
+  sh->peer_fit++;
+  if (peer->chunks[chunk])
+   sh->peer_backed++;
+  sh->last_local_used = sh->used;
+  sh->last_peer_used = peer->used;
+  sh->last_local_backing = sh->resident;
+  sh->last_peer_backing = peer->resident;
+  sh->last_request = blocks * CA_BLOCK;
+ }
+ spin_unlock(&peer->lock);
+}
 static bool ca_store(struct folio *folio)
