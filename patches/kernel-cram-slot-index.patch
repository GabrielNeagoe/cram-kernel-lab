+/* Rows name chunks that can fit an entry of exactly 1..CA_MAX_RUN slots. */
+#define CA_MAX_RUN DIV_ROUND_UP(sizeof(struct ca_entry) + PAGE_SIZE - 1, CA_BLOCK)
+static unsigned long *ca_fit;
+static unsigned int ca_row_words;
+
+static inline u64 ca_tick(void)
+{
+ return READ_ONCE(ca_profiling) ? ktime_get_ns() : 0;
+}
+
+/* All timed paths and index updates execute under ca_lock. */
+static inline void ca_elapsed(u64 start, u64 *counter)
+{
+ if (start)
+  *counter += ktime_get_ns() - start;
+}
+
+static void ca_update_fit(unsigned int chunk)
+{
+ unsigned long available = ~ca->bitmap[chunk];
+ unsigned int run;
+ u64 start = ca_tick();
+
+ for (run = 0; run < CA_MAX_RUN; run++) {
+  unsigned long *row = ca_fit + run * ca_row_words;
+  if (available)
+   __set_bit(chunk, row);
+  else
+   __clear_bit(chunk, row);
+  available &= available << 1;
+ }
+ ca_elapsed(start, &ca_index_ns);
+}
+
+static unsigned int ca_slot(unsigned int blocks)
+{
+ unsigned int idx = 0;
+ if (cram_index) {
+  unsigned int chunks = ca_blocks / CA_SLOTS;
+  unsigned long *row = ca_fit + (blocks - 1) * ca_row_words;
+  unsigned int chunk = find_first_bit(row, chunks);
+  if (chunk >= chunks)
+   return ca_blocks;
+  /* Index rows guarantee a suitable run within this chunk. */
+  idx = chunk * CA_SLOTS;
+  return bitmap_find_next_zero_area(ca->bitmap, idx + CA_SLOTS, idx, blocks, 0);
+ }
+ for (;;) {
+  idx = bitmap_find_next_zero_area(ca->bitmap, ca_blocks, idx, blocks, 0);
+  if (idx >= ca_blocks || !cram_demand || idx % CA_SLOTS + blocks <= CA_SLOTS)
+   return idx;
+  idx = round_up(idx + 1, CA_SLOTS);
+ }
+}
