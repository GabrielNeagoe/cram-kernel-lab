+#ifdef CONFIG_CRAM_ARENA
+/* Experimental: use net charge progress for direct memory.high retries. */
+static bool cram_high_net;
+module_param(cram_high_net, bool, 0444);
+static atomic_long_t cram_high_backoffs = ATOMIC_LONG_INIT(0);
+
+static int cram_high_get_backoffs(char *buf, const struct kernel_param *kp)
+{
+	return sysfs_emit(buf, "%ld\n", atomic_long_read(&cram_high_backoffs));
+}
+
+static const struct kernel_param_ops cram_high_ops = {
+	.get = cram_high_get_backoffs,
+};
+module_param_cb(cram_high_backoffs, &cram_high_ops, NULL, 0444);
+
+static bool cram_high_active(struct mem_cgroup *memcg)
+{
+	return READ_ONCE(cram_high_net) && READ_ONCE(memcg->cram_reserved) &&
+	       page_counter_read(&memcg->memory) > READ_ONCE(memcg->memory.high);
+}
+#endif
