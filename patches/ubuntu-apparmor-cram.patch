+	get_task_struct(current);
+	node->data.subjtsk = current;
+	node->data.type = AUDIT_APPARMOR_USER;
+	node->data.request = ad->request;
+	node->data.tags = ad->tags;
+	node->data.denied = ad->request & ~perms->allow;
